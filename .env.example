# Every VITE_* variable the app reads. Copy to `.env` and fill in.
# Vite only exposes variables prefixed with VITE_, and it reads the file once at
# startup — restart the dev server after any change here.
#
# An unset variable interpolates to the string "undefined", which turns an
# absolute URL into a relative one. The dev server answers those with index.html
# at HTTP 200, so the request appears to succeed and fails later as
# "Unexpected token '<'". apisInvestor.ts now names the missing variable
# instead, but the other services still fail the old way — set them all.

# --- core gateway ----------------------------------------------------------
# Base for the microservice gateway. Service names are appended in code, e.g.
# `${VITE_API_BASE_URL}/portfolio-service`, `/product-service`, `/tenant-provisioning-service`.
VITE_API_BASE_URL="http://148.251.185.111:8000"

# --- per-service bases -----------------------------------------------------
# Investor logs (Elasticsearch-backed). Used by /InvestorDashboard/Logs.
VITE_REACT_APP_API_INVESTOR_URL=""
# LMS. Used by /InvestorDashboard/Ledger for the account ledger and accounts list.
VITE_REACT_APP_API_BASE_LMS_URL=""
# Wallet. Used when approving an investment, to credit the investor's balance.
VITE_REACT_APP_API_WALLET_URL=""
VITE_REACT_APP_API_WALLET_LMS_URLL=""
# Remaining service bases referenced across the app.
VITE_REACT_APP_API_BASE_URL=""
VITE_REACT_APP_API_BASE_CMS_URL=""
VITE_REACT_APP_API_WEBPAGES_URL=""
VITE_REACT_APP_API_NOTIFICATION_URL=""
VITE_REACT_APP_API_URL_BUSINESS=""
VITE_NOTIFICATION_SERVICE_URL=""

# --- identity --------------------------------------------------------------
VITE_REACT_APP_API_IDS_URL=""
VITE_REACT_APP_IDS_CLIENT_ID=""
VITE_REACT_APP_IDS_CLIENT_SECRET=""
VITE_REACT_APP_WALLET_TOKEN=""

# --- push notifications ----------------------------------------------------
VITE_NOVU_APPLICATION_IDENTIFIER=""
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_VAPID_KEY=""
